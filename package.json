{
  "name": "opencode-fast-context",
  "version": "0.1.0",
  "description": "Bounded, decision-guided codebase retrieval for OpenCode",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "default": "./dist/legacy.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "bench": "node bench/run.ts",
    "bench:b0": "node bench/b0.ts",
    "test:corpus": "node --test test/corpus.integration.test.ts"
  },
  "engines": {
    "opencode": ">=2.0.0",
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "code-search",
    "retrieval",
    "jev",
    "clef"
  ],
  "sideEffects": false
}
